{
  "manifest_version": 3,
  "name": "PortalScrapper",
  "version": "1.0.266",
  "description": "Side Panel extension for passive capture of news articles from major portals with direct persistence to API Medialog.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://*/*",
    "https://api.medialog.com.mx/*"
  ],
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidepanel/sidepanel.html",
        "src/sidepanel/sidepanel.css",
        "dist/sidepanel.js",
        "dist/html2pdf.bundle.min.js",
        "src/assets/logos/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "PortalScrapper - Abrir Side Panel",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "32": "src/assets/icons/icon32.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  }
}